{
  "name": "ontrack",
  "private": true,
  "version": "2.7.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "VITE_BACKEND=mock VISION_PROVIDER=mock vite",
    "dev:live": "sh scripts/live-env.sh vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:live": "SUPABASE_TEST_EMAIL=ontrack.conformance@example.com sh scripts/live-env.sh vitest run tests/unit/sync-conformance.test.ts",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=screens",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm bundle && playwright test --grep @smoke",
    "bundle": "node scripts/bundle-report.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "smoke:prod": "sh scripts/smoke-prod.sh",
    "icons": "cp design/brand/app-icon.svg public/favicon.svg && pwa-assets-generator",
    "format": "prettier --write .",
    "foods:build": "tsx scripts/build-foods.ts",
    "eval:vision": "sh scripts/live-env.sh tsx scripts/eval-vision.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "@google/genai": "3.6.1",
    "@lucide/svelte": "1.77.0",
    "@supabase/supabase-js": "2.119.2",
    "barcode-detector": "3.2.4",
    "bits-ui": "2.22.0",
    "clsx": "2.1.1",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "idb-keyval": "6.3.0",
    "maplibre-gl": "6.19.0",
    "svelte": "5.59.1",
    "svelte-sonner": "1.2.3",
    "vaul-svelte": "1.0.0-next.7",
    "workbox-window": "7.4.1",
    "zod": "4.6.7",
    "zxing-wasm": "3.1.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.6",
    "@vite-pwa/assets-generator": "2.0.0",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
